# URL del backend de AVIA (servicio propio que habla con Hermes Agent).
# Vacío = la web funciona en modo local, con respuestas por reglas y sin IA.
# Nunca pongas aquí claves de OpenAI, DeepSeek, Supabase service_role ni del MCP:
# todo lo que empieza por VITE_ termina dentro del navegador.
VITE_AVIA_API_URL=

# Servidor del que se leen los datos reales (vigilante.json). Solo para npm run dev / preview.
VIGILANTE_VPS=https://vigilante-bolivia.duckdns.org
# Ruta del archivo de datos que pide la web. Si falla, se muestran los datos de ejemplo.
VITE_DATA_URL=/data/vigilante.json
