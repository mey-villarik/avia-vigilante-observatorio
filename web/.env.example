# URL del backend de AVIA (servicio propio que habla con Hermes Agent).
# Vacío = la web funciona en modo local, con respuestas por reglas y sin IA.
# Nunca pongas aquí claves de OpenAI, DeepSeek, Supabase service_role ni del MCP:
# todo lo que empieza por VITE_ termina dentro del navegador.
VITE_AVIA_API_URL=

# Servidor del que se leen los datos reales (vigilante.json). Solo para npm run dev / preview.
VIGILANTE_VPS=https://vigilante-bolivia.duckdns.org
# Ruta pública de respaldo del archivo de datos. Con login, la web lo lee primero del
# almacenamiento privado de Supabase (bucket vigilante). Déjala vacía cuando Hermes ya suba
# ahí el archivo, para que los datos solo se vean con sesión iniciada.
VITE_DATA_URL=/data/vigilante.json

# Acceso con usuario y clave (Supabase Auth). Sin estas dos variables:
#  - npm run dev entra sin login (con el selector de rol, solo para desarrollo);
#  - la versión publicada muestra «Acceso no configurado» y no deja entrar.
# La clave es la pública: «anon» o «publishable» (Settings → API). Nunca la service_role.
VITE_SUPABASE_URL=https://acgidbtnbwtorzubcgtc.supabase.co
VITE_SUPABASE_ANON_KEY=

# Web pública (publico.html, sin login): qué observatorio muestra.
VITE_CLIENTE_PUBLICO=orbita-bolivia
